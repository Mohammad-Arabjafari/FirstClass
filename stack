using System;

class Stack<T>
{
    private T[] items;
    private int top;

    public Stack(int size)
    {
        items = new T[size];
        top = -1;
    }

    public void Push(T item)
    {
        if (top == items.Length - 1)
        {
            Console.WriteLine("Stack Overflow");
            return;
        }

        items[++top] = item;
    }


    public T Pop()
    {
        if (top == -1)
            throw new Exception("Stack is Empty");

        return items[top--];
    }


    public T Peek()
    {
        if (top == -1)
            throw new Exception("Stack is Empty");

        return items[top];
    }

  
    public bool IsEmpty()
    {
        return top == -1;
    }


    public int Count()
    {
        return top + 1;
    }

 
    public void Display()
    {
        if (top == -1)
        {
            Console.WriteLine("Stack is Empty");
            return;
        }

        Console.WriteLine("Stack:");

        for (int i = top; i >= 0; i--)
        {
            Console.WriteLine(items[i]);
        }
    }
}

class Program
{
    static void Main()
    {
        Stack<int> stack = new Stack<int>(5);

        stack.Push(10);
        stack.Push(20);
        stack.Push(30);

        stack.Display();

        Console.WriteLine("----------------");

        Console.WriteLine("Pop : " + stack.Pop());

        Console.WriteLine("Peek : " + stack.Peek());

        Console.WriteLine("Count : " + stack.Count());

        stack.Display();
    }
}
